      "  @IsString()",
      "  @IsNotEmpty()",
      "  ${2:field}: string;",
      "",
      "  @IsOptional()",
      "  @IsInt()",
      "  ${3:optionalField}?: number;",
      "}",
      ""
    ],
    "description": "创建 NestJS DTO"
  },
  "TypeORM Entity": {
    "prefix": "typeorm-entity",
    "scope": "typescript",
    "body": [
      "import { Entity, PrimaryGeneratedColumn, Column, CreateDateColumn, UpdateDateColumn } from 'typeorm';",
      "",
      "@Entity('${1:table_name}')",
      "export class ${2:Name} {",
      "  @PrimaryGeneratedColumn('increment')",
      "  id: number;",
      "",
      "  @Column({ type: 'varchar', length: 255 })",
      "  ${3:field}: string;",
      "",
      "  @CreateDateColumn({ name: 'created_at' })",
      "  createdAt: Date;",
      "",
      "  @UpdateDateColumn({ name: 'updated_at' })",
      "  updatedAt: Date;",
      "}",
      ""
    ],
    "description": "创建 TypeORM 实体"
  },

