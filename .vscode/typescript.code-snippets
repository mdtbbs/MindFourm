      "import { ${1:Name}Service } from './${2:name}.service';",
      "",
      "@Module({",
      "  controllers: [${1:Name}Controller],",
      "  providers: [${1:Name}Service],",
      "})",
      "export class ${1:Name}Module {}",
      ""
    ],
    "description": "创建 NestJS 模块"
  },
  "NestJS DTO": {
    "prefix": "nest-dto",
    "scope": "typescript",
    "body": [
