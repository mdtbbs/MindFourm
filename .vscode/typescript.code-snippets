{
  // NestJS 常用片段
  "NestJS Controller": {
    "prefix": "nest-controller",
    "scope": "typescript",
    "body": [
      "import { Controller, Get, Post, Body, Patch, Param, Delete } from '@nestjs/common';",
      "import { ${1:Name}Service } from './${2:name}.service';",
      "",
      "@Controller('${3:path}')",
      "export class ${1:Name}Controller {",
      "  constructor(private readonly ${4:serviceName}: ${1:Name}Service) {}",
      "",
      "  @Get()",
      "  findAll() {",
      "    return this.${4:serviceName}.findAll();",
      "  }",
      "}",
      ""
    ],
    "description": "创建 NestJS 控制器"
  },
  "NestJS Service": {
    "prefix": "nest-service",
    "scope": "typescript",
    "body": [
