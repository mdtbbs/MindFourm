# 基地延时摄影渲染 Worker（独立进程，不使用数据库凭证）
NODE_ENV=production

# Redis：与控制面同一个实例/DB，队列为 forum:timelapse:jobs
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 与控制面 TIMELAPSE_WORKER_SECRET 完全一致；任务消息与内部 URL 都用它签名
# 为空时 Worker 会明确报错并以非 0 退出
TIMELAPSE_WORKER_SECRET=

# ffmpeg 可执行文件（需包含 libx264、libwebp 与 drawtext/drawbox 滤镜）
FFMPEG_PATH=ffmpeg
# HUD 字体；未设置时自动探测 DejaVu/Noto；找不到字体则跳过 drawtext
# TIMELAPSE_HUD_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# 临时目录；每个任务结束后递归清理
TIMELAPSE_WORK_DIR=/tmp/mdtbbs-timelapse
WORKER_POLL_TIMEOUT_SECONDS=5

# 可选：Worker 启动时额外加载的 env 文件（默认尝试项目根目录 .env）
# TIMELAPSE_WORKER_ENV_FILE=/etc/mindfourm/timelapse-worker.env
