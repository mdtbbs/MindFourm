# EditorConfig - https://editorconfig.org

# 顶级配置文件
root = true

# 所有文件的默认设置
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript / JavaScript 文件
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# JSON 文件
[*.json]
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_size = 2

# Markdown 文件
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# 配置文件
[{package.json,.prettierrc,.eslintrc,.babelrc}]
indent_size = 2

# Shell 脚本
[*.sh]
indent_size = 2

# SQL 文件
[*.sql]
indent_size = 2

# TypeScript 配置
[tsconfig.json]
indent_size = 2

# 环境变量文件
[.env*]
indent_size = 2

# Makefile 必须使用 tab
[Makefile]
indent_style = tab