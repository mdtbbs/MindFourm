{
  "name": "mindforum",
  "version": "2.1.0",
  "description": "Forum with MindAuth integration - NestJS + TypeScript + TypeORM",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "nest build",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "review:claude": "node scripts/claude-review.mjs",
    "resanitize": "node scripts/resanitize-content-html.cjs",
    "migration:run": "npm run build:backend && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build:backend && typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "npm run build:backend && typeorm migration:show -d dist/database/data-source.js",
    "migration:generate": "npm run build:backend && typeorm migration:generate -d dist/database/data-source.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "audit:resources": "npm run build:backend && node dist/scripts/resource-migration-audit.js",
    "probe:mindauth": "npm run build:backend && node dist/scripts/mindauth-capability-probe.js",
    "mock:mindauth": "npm run build:backend && node dist/scripts/mindauth-mock.js",
    "benchmark:search": "npm run build:backend && node dist/scripts/chinese-search-benchmark.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.7.0",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "dotenv": "^16.6.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "marked": "^12.0.2",
    "multer": "^2.3.0",
    "mysql2": "^3.24.3",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.17.7",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.47",
    "@types/compression": "^1.7.5",
    "@types/jest": "^29.5.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.13.0",
    "jest": "^29.7.0",
    "playwright": "^1.60.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
