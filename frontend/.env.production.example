# Copy to frontend/.env.production on the production server.
NEXT_PUBLIC_SITE_PROFILE=mdtbbs

# API 代理配置 - 留空让浏览器使用相对路径，由 Next.js rewrites 代理到后端
# 不要设置为 /api，因为 API 路径已包含 /api 前缀，会导致双 /api 问题
NEXT_PUBLIC_API_URL=
API_URL=http://127.0.0.1:4000

NEXT_PUBLIC_MINDAUTH_URL=https://auth.example.com
NEXT_PUBLIC_MINDAUTH_CLIENT_ID=forum

NEXT_PUBLIC_SITE_URL=https://forum.example.com
NEXT_PUBLIC_FRONTEND_URL=https://forum.example.com
# Must match backend SETTINGS_REVALIDATE_SECRET.
SETTINGS_REVALIDATE_SECRET=change-me

# Must match backend REVALIDATION_SECRET.
REVALIDATION_SECRET=change-me

# Server-Side Rendering 调用后端时携带的内部密钥，必须与后端 FORUM_INTERNAL_API_KEY 完全一致。
# 缺失时后端只能把 SSR 请求当作普通访客流量限流。
FORUM_INTERNAL_API_KEY=change-me

# LanLink 集成（与 backend LANLINK_ENABLED 保持一致）
NEXT_PUBLIC_LANLINK_ENABLED=true
# LanLink 控制面 API 地址（浏览器直接调用，需支持 CORS）
NEXT_PUBLIC_LANLINK_API_URL=https://ll.mdtbbs.cn

# Optional CDN for Next static assets.
# NEXT_PUBLIC_CDN_URL=https://cdn.example.com
