# ============================================
# MindFourm 前端环境配置
# ============================================

# API 配置
NEXT_PUBLIC_API_URL=http://localhost:4000     # API 后端地址（客户端直接使用，跨域时设为 API 域名）
API_URL=http://localhost:4000                 # API 地址（仅服务端使用，用于 Next.js rewrites 和 SSR 请求）

# MindAuth 单点登录
NEXT_PUBLIC_MINDAUTH_URL=http://localhost:4001  # MindAuth OAuth 服务地址
NEXT_PUBLIC_MINDAUTH_CLIENT_ID=your_client_id   # OAuth 客户端 ID

# EasyManager 游戏服务器管理
NEXT_PUBLIC_EASYMANAGER_URL=http://localhost:5001  # EasyManager 服务地址

# 域名配置
FRONTEND_URL=http://localhost:3000            # 前端地址
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000  # 前端域名（用于 SSR cookie 透传和页面跳转）
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # 站点 canonical URL（用于 sitemap / robots.txt）

# CDN 配置（可选）
# NEXT_PUBLIC_CDN_URL=https://cdn.yoursite.com  # CDN 地址，设置后 Next.js 静态资源会通过此 CDN 加载
