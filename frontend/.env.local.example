# MindFourm frontend environment

# Browser-side API. Use /api behind the production reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side API for Next.js server components and sitemap/robots generation.
API_URL=http://localhost:4000

# MindAuth OAuth
NEXT_PUBLIC_MINDAUTH_URL=http://localhost:4001
NEXT_PUBLIC_MINDAUTH_CLIENT_ID=forum

# Site canonical URL for sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional CDN for Next static assets.
# NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# LanLink integration (Mindustry LAN game mod)
# Set to 'true' to enable the LanLink feature
NEXT_PUBLIC_LANLINK_ENABLED=false
# LanLink 控制面 API 地址（浏览器直接调用，需支持 CORS）
NEXT_PUBLIC_LANLINK_API_URL=http://localhost:5100
