# MindFourm backend environment

# Runtime
NODE_ENV=development
PORT=4000
SITE_PROFILE=mdtbbs
FRONTEND_URL=http://localhost:3000
# Optional: backend calls this internal Next URL for settings cache revalidation.
# Defaults to FRONTEND_URL when unset.
FRONTEND_INTERNAL_URL=
# Shared with the frontend; set a long random value in production.
SETTINGS_REVALIDATE_SECRET=change-me
# General-purpose Next.js revalidation secret (used by RevalidationService).
REVALIDATION_SECRET=change-me
API_URL=http://localhost:4000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Note the spelling: the database matches the repository name, `mindfourm`.
MYSQL_DATABASE=mindfourm

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MindAuth OAuth
MINDAUTH_URL=http://localhost:4001
MINDAUTH_CLIENT_ID=forum
MINDAUTH_CLIENT_SECRET=change-me
# Server-only credential for POST /api/v1/native/auth/exchange. It must match
# MindAuth NATIVE_MINDFOURM_CLIENT_SECRET and must never be exposed to Android.
MINDAUTH_NATIVE_CLIENT_ID=mdtbbs_android
MINDAUTH_NATIVE_EXCHANGE_SECRET=change-me
MINDAUTH_CALLBACK_URL=http://localhost:4000/api/auth/callback
MINDAUTH_SERVICE_KEY=change-me
# Exact approved MindAuth Public Client used by the LanLink Mod. Set this to
# the client_id created/reviewed in MindAuth and enter the same ID in the Mod.
LANLINK_MINDAUTH_CLIENT_ID=lanlink-mindustry-mod

# Android Mobile Auth: generate independent high-entropy values in every environment.
MOBILE_AUTH_ISSUER=http://localhost:4000
MOBILE_AUTH_JWT_SECRET=change-me
MOBILE_AUTH_REFRESH_HMAC_SECRET=change-me

# EasyManager integration — ⏸ Paused, default off.
# Set EASYMANAGER_ENABLED=true to restore the servers feature; the frontend
# feature flag `feature_servers_enabled` must also be flipped in admin settings.
EASYMANAGER_ENABLED=false
EASYMANAGER_URL=http://localhost:5001
EASYMANAGER_API_KEY=change-me

# Persistent root for forum-managed uploads. Set this to a mounted data volume
# in production; the admin panel selects the resource subdirectory below it.
RESOURCE_UPLOAD_ROOT=./uploads

# Shared only by trusted server-side forum clients (for example the Next.js
# frontend). Never expose this as NEXT_PUBLIC_*.
FORUM_INTERNAL_API_KEY=change-me

# Forum-owned Mindustry renderer for map (.msav) and schematic (.msch) previews.
# It must bind only to loopback under a restricted account. The renderer and
# forum share RESOURCE_PREVIEW_ROOT; browsers only reach the forum proxy route.
RESOURCE_RENDERER_URL=http://127.0.0.1:6100
RESOURCE_RENDERER_TOKEN=change-me
RESOURCE_PREVIEW_ROOT=./uploads/previews
GAME_CONTENT_BLUEPRINT_MAX_BYTES=20971520
GAME_CONTENT_MAP_MAX_BYTES=20971520

# Automation/service API
FORUM_API_KEY=change-me

# LanLink integration (Mindustry LAN game mod)
# Set LANLINK_ENABLED=true to enable the LanLink feature
LANLINK_ENABLED=false
LANLINK_URL=http://localhost:5100

# Multiplayer V1 official Relay. Keep values empty while the feature is disabled.
# When feature_multiplayer_relay_v1_enabled is switched on, startup requires both
# shared credentials and the Agent allowlist. The Relay Agent calls the HTTPS
# Forum edge with MULTIPLAYER_RELAY_MACHINE_CREDENTIAL.
MULTIPLAYER_RELAY_CREDENTIAL_SECRET=
MULTIPLAYER_RELAY_MACHINE_CREDENTIAL=
MULTIPLAYER_RELAY_AGENT_IDS=

# ===== LanLink 集成部署清单 =====
# 1. 设置 LANLINK_ENABLED=true 开启 LanLink 功能
# 2. 在 External API key 管理页面为 LanLink 的 key 添加以下 scope:
#    - friends:read     读好友列表和请求
#    - presence:read    读在线状态
#    - presence:write   写在线状态（如果论坛侧也要写）
#    - notifications:write  发通知（好友邀请、开房提醒等）
# 3. 运行数据库迁移创建 friendships 表: npm run migration:run
# 4. Redis 需启用 keyspace notifications (presence 推送所需):
#    redis-cli CONFIG SET notify-keyspace-events Ex
#
# 外部 API 端点 (LanLink 控制面调用):
#   GET  /api/external/v1/friends?user_id=N
#   GET  /api/external/v1/friends/requests?user_id=N
#   GET  /api/external/v1/friends/check?user_id=N&friend_id=M
#   GET  /api/external/v1/users/search?user_id=N&q=keyword
#   GET  /api/external/v1/presence?user_ids=1,2,3
#   PUT  /api/external/v1/presence/:userId
#   DELETE /api/external/v1/presence/:userId
#   POST /api/external/v1/notifications

# E2E testing only. Registers POST /api/auth/test-login, which mints a session for
# a canned user (including an admin) without any credentials. Leave this unset
# everywhere except when running the Playwright suite. It is refused outright when
# NODE_ENV=production.
# ENABLE_TEST_AUTH=true

# Frontend production values are configured in frontend/.env.production.

# Community challenge provider. Public site keys are sent to the browser; keep
# both verification secrets server-only and never prefix them with NEXT_PUBLIC_.
COMMUNITY_CHALLENGE_PROVIDER=disabled
COMMUNITY_CHALLENGE_TICKET_TTL_SECONDS=180
COMMUNITY_CHALLENGE_TURNSTILE_SITE_KEY=
COMMUNITY_CHALLENGE_TURNSTILE_SECRET_KEY=
COMMUNITY_CHALLENGE_HCAPTCHA_SITE_KEY=
COMMUNITY_CHALLENGE_HCAPTCHA_SECRET_KEY=

# Private Mindustry Cloud Saves use the Forum host's persistent local disk.
# Configure the path in Admin > Settings > Cloud Saves; this environment path
# supplies the initial value and must point at a persistent volume in production.
CLOUD_SAVES_STORAGE_PATH=/var/lib/mindfourm/cloud-saves
CLOUD_SAVES_MAX_BYTES_PER_USER=524288000
CLOUD_SAVES_MAX_FILE_BYTES=52428800
CLOUD_SAVES_MAX_SLOTS=100
CLOUD_SAVES_MAX_HISTORY_PER_SLOT=20
CLOUD_SAVES_RETENTION_DAYS=90
CLOUD_SAVES_GC_GRACE_HOURS=24
CLOUD_SAVES_UPLOAD_SESSION_MINUTES=10
CLOUD_SAVES_MAX_MODS=100
CLOUD_SAVES_MAX_MANIFEST_BYTES=16384
