# ============================================
# MindFourm Backend Environment Configuration
# ============================================

# Server
PORT=4000                       # API 服务端口
NODE_ENV=development            # 运行环境: development | production

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mindforum

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Domain Configuration
FRONTEND_URL=http://localhost:3000       # 前端地址（用于 CORS 和 OAuth 回调后 redirect）
API_URL=http://localhost:4000            # API 后端地址（用于 MindAuth callbackUrl 构建）
# COOKIE_DOMAIN=.forum.example.com       # Cookie 域名，前后端同主域不同子域时启用（点号开头表示主域及所有子域）

# CDN Configuration (optional)
# CDN_URL=https://cdn.yoursite.com       # CDN 地址，设置后静态资源响应头会附带 CDN 信息
# STATIC_CACHE_TTL=86400                 # 静态资源缓存时间（秒），默认 86400（24 小时）

# MindAuth SSO
MINDAUTH_URL=http://localhost:4001       # MindAuth OAuth 服务地址
MINDAUTH_CLIENT_ID=your_client_id        # OAuth 客户端 ID
MINDAUTH_CLIENT_SECRET=your_client_secret  # OAuth 客户端密钥
MINDAUTH_CALLBACK_URL=http://localhost:4000/api/auth/callback  # OAuth 回调地址（生产环境需改为 API 域名）

# EasyManager (Game Server Management)
EASYMANAGER_URL=http://localhost:5001    # EasyManager 服务地址
EASYMANAGER_API_KEY=your_api_key         # 服务间调用密钥（需与 EasyManager 配置一致）
