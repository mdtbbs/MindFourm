# MindFourm backend environment

# Runtime
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Note the spelling: the database matches the repository name, `mindfourm`.
MYSQL_DATABASE=mindfourm

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MindAuth OAuth
MINDAUTH_URL=http://localhost:4001
MINDAUTH_CLIENT_ID=forum
MINDAUTH_CLIENT_SECRET=change-me
MINDAUTH_CALLBACK_URL=http://localhost:4000/api/auth/callback
MINDAUTH_SERVICE_KEY=change-me

# EasyManager integration
EASYMANAGER_URL=http://localhost:5001
EASYMANAGER_API_KEY=change-me

# Automation/service API
FORUM_API_KEY=change-me

# LanLink integration (Mindustry LAN game mod)
# Set LANLINK_ENABLED=true to enable the LanLink feature
LANLINK_ENABLED=false
LANLINK_URL=http://localhost:5100

# E2E testing only. Registers POST /api/auth/test-login, which mints a session for
# a canned user (including an admin) without any credentials. Leave this unset
# everywhere except when running the Playwright suite. It is refused outright when
# NODE_ENV=production.
# ENABLE_TEST_AUTH=true

# Frontend production values are configured in frontend/.env.production.
