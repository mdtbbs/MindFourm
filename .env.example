# ============================================
# MindFourm 后端环境配置
# ============================================

# 服务器配置
PORT=4000                       # API 服务端口
NODE_ENV=development            # 运行环境: development(开发) | production(生产)

# MySQL 数据库
MYSQL_HOST=localhost            # 数据库主机
MYSQL_PORT=3306                 # 数据库端口
MYSQL_USER=root                 # 数据库用户名
MYSQL_PASSWORD=                 # 数据库密码
MYSQL_DATABASE=mindforum        # 数据库名称

# Redis 缓存
REDIS_HOST=127.0.0.1           # Redis 主机
REDIS_PORT=6379                 # Redis 端口
REDIS_PASSWORD=                 # Redis 密码（无密码留空）
REDIS_DB=0                      # Redis 数据库编号

# 域名配置
FRONTEND_URL=http://localhost:3000       # 前端地址（用于 CORS 和 OAuth 回调后重定向）
API_URL=http://localhost:4000            # API 后端地址（用于 MindAuth 回调地址构建）
# COOKIE_DOMAIN=.forum.example.com       # Cookie 域名，前后端同主域不同子域时启用（点号开头表示主域及所有子域）

# CDN 配置（可选）
# CDN_URL=https://cdn.yoursite.com       # CDN 地址，设置后静态资源响应头会附带 CDN 信息
# STATIC_CACHE_TTL=86400                 # 静态资源缓存时间（秒），默认 86400（24小时）

# MindAuth 单点登录
MINDAUTH_URL=http://localhost:4001       # MindAuth OAuth 服务地址
MINDAUTH_CLIENT_ID=your_client_id        # OAuth 客户端 ID
MINDAUTH_CLIENT_SECRET=your_client_secret  # OAuth 客户端密钥
MINDAUTH_CALLBACK_URL=http://localhost:4000/api/auth/callback  # OAuth 回调地址（生产环境需改为 API 域名）

# EasyManager 游戏服务器管理
EASYMANAGER_URL=http://localhost:5001    # EasyManager 服务地址
EASYMANAGER_API_KEY=your_api_key         # 服务间调用密钥（需与 EasyManager 配置一致）
