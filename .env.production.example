# Copy to .env on the production server.

# ============================================
# 重要：站点URL配置
# ============================================
# FRONTEND_URL 用于初始化数据库的 site_url 设置
# 部署后可以在管理后台「基础设置」中修改
# 此配置影响：邮件链接、RSS订阅、OAuth回调等
FRONTEND_URL=https://forum.example.com
# Optional internal Next URL used by backend for settings cache revalidation.
# Defaults to FRONTEND_URL when unset.
FRONTEND_INTERNAL_URL=
# Must match frontend SETTINGS_REVALIDATE_SECRET.
SETTINGS_REVALIDATE_SECRET=replace-with-random-settings-revalidate-secret

NODE_ENV=production
PORT=4000

# FRONTEND_URL 和 API_URL 已在上方配置
API_URL=https://forum.example.com

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mindforum
MYSQL_PASSWORD=replace-with-db-password
MYSQL_DATABASE=mindforum

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_DB=0

MINDAUTH_URL=https://auth.example.com
MINDAUTH_CLIENT_ID=forum
MINDAUTH_CLIENT_SECRET=replace-with-mindauth-client-secret
MINDAUTH_CALLBACK_URL=https://forum.example.com/api/auth/callback
MINDAUTH_SERVICE_KEY=replace-with-mindauth-service-key

# EasyManager — 已暂停，默认关闭
EASYMANAGER_ENABLED=false
EASYMANAGER_URL=https://manager.example.com
EASYMANAGER_API_KEY=replace-with-easymanager-api-key

# MindFileList 集成
MFL_BASE_URL=https://files.example.com
MFL_API_KEY=replace-with-mfl-api-key

SESSION_SECRET=replace-with-random-32-char-secret
FORUM_API_KEY=replace-with-forum-service-api-key

# LanLink 集成（Mindustry 联机 Mod）
# 设为 true 开启 LanLink 好友/在线状态/邀请功能
LANLINK_ENABLED=true
LANLINK_URL=https://lanlink.example.com

# 部署后还需：
# 1. External API key 添加 scope: friends:read, presence:read, presence:write, notifications:write
# 2. 跑迁移: npm run migration:run（创建 friendships 表）
# 3. Redis 启用 keyspace notifications: CONFIG SET notify-keyspace-events Ex
