# Copy to .env on the production server.

NODE_ENV=production
PORT=4000

FRONTEND_URL=https://forum.example.com
API_URL=https://forum.example.com

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mindforum
MYSQL_PASSWORD=replace-with-db-password
MYSQL_DATABASE=mindforum

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MINDAUTH_URL=https://auth.example.com
MINDAUTH_CLIENT_ID=forum
MINDAUTH_CLIENT_SECRET=replace-with-mindauth-client-secret
MINDAUTH_CALLBACK_URL=https://forum.example.com/api/auth/callback
MINDAUTH_SERVICE_KEY=replace-with-mindauth-service-key

EASYMANAGER_URL=https://manager.example.com
EASYMANAGER_API_KEY=replace-with-easymanager-api-key

FORUM_API_KEY=replace-with-forum-service-api-key
